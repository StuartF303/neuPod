# Build output (all platforms)
build/
build-*/
platforms/esp32s3/build/
platforms/esp32s3/managed_components/
platforms/esp32s3/sdkconfig
platforms/esp32s3/sdkconfig.old
platforms/esp32s3/dependencies.lock

# Firmware images outside releases/
*.uf2
!releases/**/*.uf2

# Editor / IDE (keep shared settings)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# Host tooling
__pycache__/
*.pyc
.venv/
site/
bin/
obj/
*.img

# OS
.DS_Store
Thumbs.db
.claude/worktrees/

# Claude Code agent worktrees (the project skill in .claude/skills is tracked)
.claude/worktrees/

# Secrets and signing material, anywhere in the repository (the repository is public)
*.jks
*.keystore
key.properties
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
*.pem
*.pepk
*.certSigningRequest
ExportOptions.plist
GoogleService-Info.plist
google-services.json
.env
.env.*
!.env.example
local.properties

# Phone app (mobile/): build outputs and tool caches
# (mobile/.gitignore has the full Flutter list; these repeat the essentials at the root)
mobile/**/.dart_tool/
mobile/**/build/
mobile/**/Pods/
mobile/**/ios/Flutter/ephemeral/
mobile/**/.flutter-plugins-dependencies

# Phone app: never commit personal music. Audio under mobile/ is ignored (any letter case) except in the
# fixture folders re-included below; the firmware fixtures in tests/assets/audio are outside mobile/ and unaffected.
mobile/test_music/
mobile/**/*.[Ff][Ll][Aa][Cc]
mobile/**/*.[Mm][Pp]3
mobile/**/*.[Mm]4[Aa]
mobile/**/*.[Mm]4[Bb]
mobile/**/*.[Aa][Aa][Cc]
mobile/**/*.[Ww][Aa][Vv]
mobile/**/*.[Aa][Ii][Ff]
mobile/**/*.[Aa][Ii][Ff][Ff]
mobile/**/*.[Oo][Gg][Gg]
mobile/**/*.[Oo][Pp][Uu][Ss]
mobile/**/*.[Dd][Ss][Ff]
mobile/**/*.[Dd][Ff][Ff]
mobile/**/*.[Ww][Mm][Aa]
mobile/**/*.[Aa][Pp][Ee]
mobile/**/*.[Ww][Vv]
mobile/**/*.[Mm][Kk][Aa]
!mobile/test/assets/**
!mobile/test/fixtures/**
!mobile/integration_test/assets/**
!mobile/packages/*/test/assets/**
!mobile/packages/*/example/assets/**
