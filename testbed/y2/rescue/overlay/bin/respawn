#!/bin/sh
# respawn NAME CMD [ARGS...]: run CMD forever, restarting after it exits with a growing delay
# (1, 2, 4 ... capped at 30 s). Logs once per backoff step, and once on reaching the cap.
name=$1
shift
delay=1
capped=0
while :; do
	"$@"
	rc=$?
	if [ $delay -lt 30 ]; then
		echo "y2-rescue: $name exited rc=$rc, restarting in ${delay}s" >>/tmp/rescue.log
	elif [ $capped -eq 0 ]; then
		echo "y2-rescue: $name keeps exiting rc=$rc, retrying every 30 s (not logging further)" >>/tmp/rescue.log
		capped=1
	fi
	sleep $delay
	delay=$((delay * 2))
	[ $delay -gt 30 ] && delay=30
done
