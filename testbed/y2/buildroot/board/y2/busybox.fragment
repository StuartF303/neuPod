# Merged over Buildroot's default busybox.config (see y2_defconfig). Dynamic linking (glibc).
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_TEST=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_ECHO=y
CONFIG_SH_IS_ASH=y
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y
CONFIG_FEATURE_MDEV_EXEC=y
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_IFCONFIG=y
CONFIG_IP=y
CONFIG_UDHCPD=y
# CONFIG_FEATURE_UDHCPD_BASE_IP_ON_MAC is not set
CONFIG_TIMEOUT=y
CONFIG_SETSID=y
CONFIG_HEXDUMP=y
CONFIG_XXD=y
CONFIG_DEVMEM=y
CONFIG_KILLALL=y
CONFIG_NC=y
CONFIG_WGET=y
CONFIG_SEQ=y
CONFIG_STTY=y
CONFIG_START_STOP_DAEMON=y
# CONFIG_TELNETD is not set
# CONFIG_HTTPD is not set
