#!/bin/sh
# neuPod C firmware on the Y2 (platforms/y2). Starts only if /etc/neupod-ui contains "fw" (the .NET demo, S90neupod-demo,
# owns /dev/fb0 otherwise) and /opt/neupod-fw/neupod exists, which testbed/y2/scripts/deploy-fw.sh puts there. Runs under
# a respawn wrapper (2 s pause so a crash cannot spin); the log is on tmpfs, not eMMC, and is emptied whenever it passes
# 256 KB.
#
# Process model: the wrapper is started with setsid, so it leads its own process group; the app, the log trimmer and
# everything else it spawns are in that group. The init script writes the wrapper's pid itself, before start returns
# ($! is the setsid'd wrapper), so a start is never "running but unrecorded", and stop signals the whole group
# (kill -TERM -PGID): there is no moment between spawning the app and recording it in which a stop could orphan it.
# stop never kills by name. A second start while the wrapper is alive does nothing (a mkdir lock keeps two concurrent
# starts apart). SIGTERM makes the app shut down in order (up to 2 s waiting for a card write); stop waits up to 5 s for
# the group to go, then SIGKILLs it. Power key held: the app stops in order, starts /sbin/poweroff detached (own session, so
# the group kill of stop cannot reach it) and exits 77; the wrapper does not respawn at once, and init's own stop
# runs this script's stop, which ends the wrapper (the log trimmer may linger up to 5 s; stop kills it with the group).
# If the system is still up 15 s after that exit 77 (NEUPOD_POWEROFF_WAIT overrides, for tests), poweroff failed: the wrapper
# logs "poweroff did not happen, restarting" and respawns the app.
# Charging-only mode (boot mode 8/9) is described at selected() below.
# Optional settings: /etc/neupod-fw.env (NAME=value lines, e.g. NEUPOD_Y2_HAPTIC_MS="20,40,90") is sourced before the app starts, so
# the variables reach it. Nothing creates it (deploy-fw.sh leaves it alone) and the app runs fine without it. It is only used
# if it is a regular file (not a symlink), owned by root, not writable by group or others and syntactically valid; otherwise
# it is logged and skipped. NEUPOD_FW_ENV_FILE and NEUPOD_FW_ENV_UID override the path and owner, for tests.
# Keys can be sent from ssh while it runs:  echo s > /run/neupod.keys   (w/s scroll, e select, m menu, a/d left/right, p play)
APP=/opt/neupod-fw/neupod
UI_FILE=/etc/neupod-ui
WRAP_PID=/run/neupod-fw.pid
APP_PID=/run/neupod-fw.app.pid
LOCK=/run/neupod-fw.start.lock
FIFO=/run/neupod.keys
LOG=/tmp/neupod-fw.log
ENV_FILE=${NEUPOD_FW_ENV_FILE:-/etc/neupod-fw.env}
ENV_UID=${NEUPOD_FW_ENV_UID:-0}
POWEROFF_WAIT=${NEUPOD_POWEROFF_WAIT:-15}
# Charging-only mode: the bootloader powered the device on because USB was attached while it was "off" (MediaTek boot mode
# 8 = KERNEL_POWER_OFF_CHARGING, 9 = LOW_POWER_OFF_CHARGING). NEUPOD_BOOT_MODE_FILE overrides the path, for tests.
BOOT_MODE_FILE=${NEUPOD_BOOT_MODE_FILE:-/sys/class/BOOT/BOOT/boot/boot_mode}
charging() { local m; m=$(tr -d ' \t\r\n' 2>/dev/null <"$BOOT_MODE_FILE"); [ "$m" = 8 ] || [ "$m" = 9 ]; }

alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
group_alive() { [ -n "$1" ] && kill -0 "-$1" 2>/dev/null; }

# In charging-only mode the firmware starts whatever /etc/neupod-ui says (the .NET demo is skipped by S90): the firmware
# itself reads the boot mode and runs its small charging loop instead of the UI. Its exit 77 (Power held: /sbin/reboot, or
# charger removed 3 s: /sbin/poweroff) takes the same no-respawn path as a normal power-off.
selected() { charging || [ "$(tr -d ' \t\r\n' <"$UI_FILE" 2>/dev/null)" = fw ]; }

# Source ENV_FILE (exporting everything it sets) if it exists and is trustworthy. Busybox ash compatible.
load_env() {
	[ -e "$ENV_FILE" ] || return 0
	if [ ! -f "$ENV_FILE" ] || [ -L "$ENV_FILE" ]; then
		echo "neupod-fw: $ENV_FILE ignored (not a regular file)"
		return 0
	fi
	st=$(stat -c '%u %a' "$ENV_FILE" 2>/dev/null)
	uid=${st% *}
	perm=${st#* }
	case "$perm" in
		*[0145][0145]) ;;  # group and others: no write bit (digits 0, 1, 4, 5)
		*) echo "neupod-fw: $ENV_FILE ignored (writable by group or others)"; return 0 ;;
	esac
	if [ "$uid" != "$ENV_UID" ]; then
		echo "neupod-fw: $ENV_FILE ignored (not owned by root)"
		return 0
	fi
	if ! sh -n "$ENV_FILE" 2>/dev/null; then
		echo "neupod-fw: $ENV_FILE ignored (syntax error)"
		return 0
	fi
	set -a
	. "$ENV_FILE"
	set +a
}

start() {
	[ -x "$APP" ] || return 0
	selected || return 0
	mkdir "$LOCK" 2>/dev/null || { echo "neupod-fw: another start is in progress"; return 0; }
	if alive "$(cat "$WRAP_PID" 2>/dev/null)"; then
		rmdir "$LOCK"
		echo "neupod-fw already running"
		return 0
	fi
	load_env
	: >"$LOG"
	setsid sh -c '
		while :; do
			[ "$(wc -c <"$3")" -gt 262144 ] && : >"$3"
			"$1" --splash-hold-ms 3000 &
			app=$!
			echo $app >"$2"
			# Trim the log while the app runs (the shell holds it open O_APPEND, so truncating in place is safe).
			# A separate subshell, because this one sits in wait: a kill -0 poll here would also succeed on the
			# exited-but-unreaped app and never notice a crash. The trimmer ends within 5 s of the app.
			(while sleep 5 && kill -0 $app 2>/dev/null; do
				[ "$(wc -c <"$3")" -gt 262144 ] && : >"$3"
			done) &
			wait $app
			rc=$?
			rm -f "$2"
			# 77 = the app was asked to power the device off (Power key held) and has started poweroff. Do not respawn
			# straight away: init is about to stop this whole group (kill -TERM), which ends this sleep. If the system is
			# still up after $4 s, poweroff did not happen, so fall through to the respawn rather than leave a dead UI.
			if [ "$rc" = 77 ]; then
				echo "neupod-fw exited for poweroff, waiting $4 s" >&2
				sleep "$4"
				echo "poweroff did not happen, restarting" >&2
			fi
			echo "neupod-fw exited ($rc), restarting in 2 s" >&2
			sleep 2
		done
	' _ "$APP" "$APP_PID" "$LOG" "$POWEROFF_WAIT" </dev/null >>"$LOG" 2>&1 &
	echo $! >"$WRAP_PID"
	rmdir "$LOCK"
}

stop() {
	wp=$(cat "$WRAP_PID" 2>/dev/null)
	if [ -n "$wp" ] && group_alive "$wp"; then
		# The whole group at once: wrapper (so it cannot respawn), app (orderly shutdown on SIGTERM) and trimmer.
		kill -TERM "-$wp" 2>/dev/null
		i=0
		while group_alive "$wp" && [ $i -lt 50 ]; do
			sleep 0.1
			i=$((i + 1))
		done
		group_alive "$wp" && kill -KILL "-$wp" 2>/dev/null
	fi
	rm -f "$WRAP_PID" "$APP_PID" "$FIFO"
	rmdir "$LOCK" 2>/dev/null
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
