#!/bin/sh
# /dev: the stock kernel has no devtmpfs. The y2-rescue hand-off moves a populated tmpfs /dev in; if we
# were started with an empty /dev instead, build one. Then (re)arm mdev as hotplug helper and coldplug.
start() {
	[ -d /proc/self ] || mount -t proc proc /proc
	[ -d /sys/class ] || mount -t sysfs sysfs /sys
	if [ ! -c /dev/null ]; then
		mount -t tmpfs -o mode=0755,size=2m tmpfs /dev
		mknod -m 600 /dev/console c 5 1
		mknod -m 666 /dev/null c 1 3
		mknod -m 666 /dev/zero c 1 5
		mknod -m 666 /dev/tty c 5 0
		mknod -m 600 /dev/tty0 c 4 0
		mknod -m 666 /dev/ptmx c 5 2
		mknod -m 666 /dev/urandom c 1 9
		mknod -m 666 /dev/random c 1 8
		mknod -m 660 /dev/fb0 c 29 0
	fi
	mkdir -p /dev/pts /dev/shm /dev/input /dev/snd /dev/graphics
	echo /sbin/mdev >/proc/sys/kernel/hotplug
	mdev -s
	[ -e /dev/fd ] || ln -s /proc/self/fd /dev/fd
	[ -e /dev/stdin ] || ln -s /proc/self/fd/0 /dev/stdin
	[ -e /dev/stdout ] || ln -s /proc/self/fd/1 /dev/stdout
	[ -e /dev/stderr ] || ln -s /proc/self/fd/2 /dev/stderr
	echo 5 >/proc/sys/kernel/printk
}
case "$1" in
	start) start ;;
	stop) : ;;
	*) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
exit 0
