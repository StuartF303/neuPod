# Merged over Buildroot's default busybox.config (see y2_rescue_defconfig).
# Static linking is forced by BR2_STATIC_LIBS.
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_TEST=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_ECHO=y
CONFIG_SH_IS_ASH=y
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y
CONFIG_FEATURE_MDEV_EXEC=y
CONFIG_TELNETD=y
CONFIG_FEATURE_TELNETD_STANDALONE=y
CONFIG_GETTY=y
CONFIG_IFCONFIG=y
CONFIG_IP=y
CONFIG_UDHCPD=y
CONFIG_HEXDUMP=y
CONFIG_DD=y
CONFIG_SWITCH_ROOT=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_BLKID=y
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_FBSET=y
CONFIG_DEVMEM=y
CONFIG_STTY=y
CONFIG_SETSID=y
CONFIG_NC=y
CONFIG_HTTPD=y
CONFIG_WGET=y
CONFIG_TFTP=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y
CONFIG_DMESG=y
CONFIG_I2CGET=y
CONFIG_I2CSET=y
CONFIG_I2CDUMP=y
CONFIG_I2CDETECT=y
CONFIG_TIMEOUT=y
CONFIG_KILLALL=y
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_LSMOD=y
CONFIG_INSMOD=y
CONFIG_MKNOD=y
CONFIG_SEQ=y
CONFIG_OD=y
CONFIG_XXD=y
