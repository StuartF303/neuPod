# Writes the generated version header only when its content changes (so a rebuild does not
# recompile everything). Run at build time:  cmake -DOUT=... -DSRC_DIR=... -DVERSION=... -P version.cmake
execute_process(COMMAND git -C ${SRC_DIR} describe --always --dirty --abbrev=7
                OUTPUT_VARIABLE GIT_HASH OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET RESULT_VARIABLE GIT_RESULT)
if(NOT GIT_RESULT EQUAL 0 OR GIT_HASH STREQUAL "")
  set(GIT_HASH "nogit")
endif()
set(CONTENT "// Generated by cmake/version.cmake; do not edit.\n#pragma once\n#define NEUPOD_VERSION \"${VERSION}\"\n#define NEUPOD_GIT_HASH \"${GIT_HASH}\"\n")
set(OLD "")
if(EXISTS ${OUT})
  file(READ ${OUT} OLD)
endif()
if(NOT "${OLD}" STREQUAL "${CONTENT}")
  file(WRITE ${OUT} "${CONTENT}")
endif()
