<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer on Android 12 and later (android:dataExtractionRules). The same rule as
     backup_rules.xml (owner decision 20): only filesDir/stats, the ratings and play counts database. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="stats/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="stats/" />
    </device-transfer>
</data-extraction-rules>
