<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and earlier (android:fullBackupContent). Owner decision 20: only the ratings and play
     counts database is backed up (filesDir/stats, neupod_storage backedUpDataPath()). The library database and the
     art cache are in noBackupFilesDir, which Android never backs up; with an include rule nothing else is either. -->
<full-backup-content>
    <include domain="file" path="stats/" />
</full-backup-content>
