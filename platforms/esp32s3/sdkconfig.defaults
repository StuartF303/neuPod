# ESP32-S3 defaults for neuPod. Board-specific values (flash size, PSRAM mode) are TODO
# until the comparison module is chosen.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# TODO: CONFIG_ESPTOOLPY_FLASHSIZE_* and CONFIG_SPIRAM_* for the chosen module
